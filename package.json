{
  "name": "ream",
  "private": true,
  "version": "0.1.155",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "seed:fetch": "node scripts/fetch-seed.mjs",
    "icons": "node scripts/icons.mjs",
    "proofread": "node scripts/proofread/review.mjs",
    "proofread:package": "node scripts/proofread/sync.mjs package",
    "proofread:merge": "node scripts/proofread/sync.mjs merge",
    "soul-sea": "node scripts/soul-sea/extract.mjs && node scripts/soul-sea/build.mjs && node scripts/soul-sea/review.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm test && npm run lint && npm run format:check && npm run test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "prettier": "^3.9.6",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  }
}
